# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
/build/
/dist/
*.egg-info/
.eggs/

# Virtual environments (uv / venv)
.venv/
venv/
ENV/

# Test, coverage and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Local env files
.env
.env.local
.env.*.local

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Note: .python-version and uv.lock are intentionally committed to pin the
# interpreter and dependencies, so they are not ignored here.
